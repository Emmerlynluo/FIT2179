{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Swimming Is Australia's Leading Summer Olympic Sport",
    "subtitle": "Top 5 sports by total medals",
    "anchor": "start",
    "fontSize": 20,
    "subtitleFontSize": 13
  },
  "width": 650,
  "height": {
    "step": 40
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/australia_summer_olympic_medals_by_sport_long.csv"
  },
  "transform": [
    {
      "filter": "datum.medal_count > 0"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "medal_count",
          "as": "sport_total"
        }
      ],
      "groupby": ["sport"]
    },
    {
      "filter": "datum.sport == 'Swimming' || datum.sport == 'Athletics' || datum.sport == 'Cycling' || datum.sport == 'Rowing' || datum.sport == 'Canoeing'"
    },
    {
      "calculate": "datum.sport == 'Swimming' ? 'Swimming' : 'Other sports'",
      "as": "highlight_group"
    },
    {
      "calculate": "datum.medal_type == 'Gold' ? 1 : datum.medal_type == 'Silver' ? 2 : 3",
      "as": "medal_order"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 24,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "sport",
          "type": "nominal",
          "sort": ["Swimming", "Athletics", "Cycling", "Rowing", "Canoeing"],
          "title": null,
          "axis": {
            "labelFontSize": 12
          }
        },
        "x": {
          "field": "medal_count",
          "type": "quantitative",
          "stack": "zero",
          "title": "Total medals",
          "scale": {
            "domain": [0, 240]
          }
        },
        "color": {
          "field": "highlight_group",
          "type": "nominal",
          "scale": {
            "domain": ["Swimming", "Other sports"],
            "range": ["#0077b6", "#cfcfcf"]
          },
          "legend": null
        },
        "order": {
          "field": "medal_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          { "field": "sport", "title": "Sport" },
          { "field": "medal_type", "title": "Medal type" },
          { "field": "medal_count", "title": "Medals" },
          { "field": "sport_total", "title": "Total medals" }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "sport_total",
              "as": "sport_total"
            }
          ],
          "groupby": ["sport"]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "sport",
          "type": "nominal",
          "sort": ["Swimming", "Athletics", "Cycling", "Rowing", "Canoeing"]
        },
        "x": {
          "field": "sport_total",
          "type": "quantitative"
        },
        "text": {
          "field": "sport_total",
          "type": "quantitative"
        },
        "color": {
          "condition": {
            "test": "datum.sport == 'Swimming'",
            "value": "#003049"
          },
          "value": "#555555"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false
    }
  }
}