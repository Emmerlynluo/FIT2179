{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "padding": {
    "top": 10,
    "left": 0,
    "right": 0,
    "bottom": 0
  },

  "title": {
    "text": "Australia's Olympic Swimming Medals Over Time",
    "fontSize": 18,
    "anchor": "start",
    "offset": 10
    
  },

  "data": {
    "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_olympic_swimming_medals_long.csv"
  },

  "transform": [
    {
      "calculate": "datum.Medal == 'Gold' ? 1 : datum.Medal == 'Silver' ? 2 : 3",
      "as": "MedalOrder"
    }
  ],

  "vconcat": [
    {
      "width": 720,
      "height": 300,

      "mark": {
        "type": "bar",
        "tooltip": true,
        "size": 12
      },

      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "scale": {
            "domain": {
              "param": "year_brush"
            },
            "nice": false
          },
          "axis": {
            "title": "Olympic Year",
            "format": "d",
            "tickMinStep": 4,
            "values": [1900, 1910, 1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020]
          }
        },

        "y": {
          "field": "Count",
          "type": "quantitative",
          "aggregate": "sum",
          "title": "Number of Medals"
        },

        "color": {
          "field": "Medal",
          "type": "nominal",
          "title": "Medal Type",
          "scale": {
            "domain": ["Gold", "Silver", "Bronze"],
            "range": ["#D4AF37", "#C0C0C0", "#CD7F32"]
          },
          "legend": {
              "orient": "none",
              "legendX": 30,
              "legendY": 12,
              "direction": "vertical",
              "titleFontSize": 11,
              "labelFontSize": 10,
              "fillColor": "white",
              "strokeColor": "#D9E3EA",
              "padding": 6,
              "cornerRadius": 4
          }
        },

        "order": {
          "field": "MedalOrder",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Olympic Year",
            "format": "d"
          },
          {
            "field": "Medal",
            "type": "nominal",
            "title": "Medal Type"
          },
          {
            "field": "Count",
            "type": "quantitative",
            "aggregate": "sum",
            "title": "Medal Count"
          }
        ]
      }
    },

    {
      "width": 720,
      "height": 80,
      
      "title": {
        "text": "Overview Timeline: Drag to Select a Period",
        "fontSize": 13,
        "anchor": "start"
      },

      "params": [
        {
          "name": "year_brush",
          "select": {
            "type": "interval",
            "encodings": ["x"]
          }
        }
      ],

      "mark": {
        "type": "area",
        "opacity": 0.65,
        "line": true
      },

      "encoding": {
        "x": {
          "field": "Year",
          "type": "quantitative",
          "axis": {
            "title": "Olympic Year",
            "format": "d",
            "tickMinStep": 4,
            "values": [1900, 1910, 1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020]
          },
          "scale": {
            "nice": false
          }
        },

        "y": {
          "field": "Count",
          "type": "quantitative",
          "aggregate": "sum",
          "title": "Total",
          "axis": {
            "tickCount": 3,
            "grid": false
          }
        },

        "tooltip": [
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Olympic Year",
            "format": "d"
          },
          {
            "field": "Count",
            "type": "quantitative",
            "aggregate": "sum",
            "title": "Total Swimming Medals"
          }
        ]
      }
    }
  ],

  "resolve": {
    "scale": {
      "color": "shared"
    }
  },

  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false
    }
  }
}