oga' : datum.activity == 'Cycling' ? 'Cycling' : datum.activity == 'Pilates' ? 'Pilates' : datum.activity == 'Surfing' ? 'Surfing' : datum.activity == 'Rugby union' ? 'Rugby union' : datum.activity == 'Rugby league' ? 'Rugby league' : datum.activity == 'Rowing' ? 'Rowing' : datum.activity == 'Hockey' ? 'Hockey' : datum.activity == 'Cricket' ? 'Cricket' : datum.activity == 'Squash' ? 'Squash' : datum.activity == 'Skate' ? 'Skate' : datum.activity == 'Equestrian' ? 'Equestrian' : datum.activity == 'Baseball' ? 'Baseball' : datum.activity == 'Calisthenics' ? 'Calisthenics' : datum.activity == 'Sport climbing' ? 'Sport climbing' : datum.activity == 'Sailing' ? 'Sailing' : datum.activity",
      "as": "short_label"
    },

    {
      "calculate": "length(datum.short_label)",
      "as": "label_len"
    },

    {
      "calculate": "datum.rank_num == 1 ? 38 : datum.rank_num == 2 ? 35 : datum.rank_num == 3 ? 33 : datum.rank_num == 4 ? 31 : datum.rank_num == 5 ? 29 : datum.rank_num == 6 ? 27 : datum.rank_num == 7 ? 26 : datum.rank_num == 8 ? 25 : datum.rank_num == 9 ? 24 : datum.rank_num == 10 ? 23 : datum.rank_num <= 15 ? 21 : datum.rank_num <= 20 ? 19 : datum.rank_num <= 30 ? 17 : datum.rank_num <= 40 ? 15 : 13",
      "as": "base_size"
    },
