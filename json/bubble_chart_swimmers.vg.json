{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_star_swimmers.csv"
  },
  "width": 550,
  "height": 400,
  "autosize": {
  "type": "fit",
  "contains": "padding"
  },
  "params": [
    {
      "name": "genderFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "F", "M"],
        "labels": ["All", "Women", "Men"],
        "name": "Gender: "
      }
    },
    {
      "name": "minAppearances",
      "value": 5,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 30,
        "step": 1,
        "name": "Min Appear: "
      }
    }
  ],
  "transform": [
    {
      "filter": "genderFilter == 'All' || datum.gender == genderFilter"
    },
    {
      "filter": "datum.appearances >= minAppearances"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "best_rank",
          "type": "quantitative",
          "scale": {
            "domainMin": 0
          },
          "title": "Best World Ranking"
        },
        "y": {
          "field": "appearances",
          "type": "quantitative",
          "title": "Top 200 Appearances"
        },
        "size": {
          "field": "events_count",
          "type": "quantitative",
          "title": "Events Appeared In",
          "scale": {
            "domain": [1, 3],
            "range": [120, 900]
          },
          "legend": {
            "values": [1, 2, 3],
            "title": "Appeared In"
          }
        },
        "color": {
          "field": "primary_distance_group",
          "type": "nominal",
          "title": "Distance Type",
          "scale": {
            "domain": ["Sprint", "Middle-distance", "Distance"],
            "range": ["#F2A65A", "#006B54", "#4C78A8"]
          },
           "legend": {
            "labelExpr": "replace(replace(datum.label, 'Middle-distance', 'Middle'), 'Distance', 'Long')"
          }
        },
        "tooltip": [
          {"field": "athlete", "title": "Athlete"},
          {"field": "appearances", "title": "Top 200 Appearances"},
          {"field": "best_rank", "title": "Best Rank"},
          {"field": "best_event", "title": "Best Event"},
          {"field": "best_time", "title": "Best Time"},
          {"field": "events", "title": "Events"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 15,
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#263238"
      },
      "encoding": {
        "x": {
          "field": "best_rank",
          "type": "quantitative",
          "scale": {
            "domainMin": 0
          }
        },
        "y": {
          "field": "appearances",
          "type": "quantitative"
        },
        "text": {
          "field": "athlete"
        }
      }
    }
  ],
  "title": "Australia's Star Freestyle Swimmers: Repeated Excellence",
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 17,
      "anchor": "start"
    },
    "legend": {
      "titleFontSize": 12,
      "labelFontSize": 11
    }
  }
}