{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/dumbbell_aus_usa.csv"
  },
  "width": 540,
  "height": 310,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "bounds": "flush",
  "padding": {
    "top": 0,
    "bottom": 0,
    "left": 0,
    "right": 0
  },
  "params": [
    {
      "name": "genderFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "F", "M"],
        "labels": ["All", "Women", "Men"],
        "name": "Gender: "
      }
    }
  ],
  "transform": [
    {
      "filter": "genderFilter == 'All' || datum.gender == genderFilter"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2,
        "color": "#606567",
        "opacity": 0.9
      },
      "encoding": {
        "y": {
          "field": "event_label",
          "type": "nominal",
          "sort": [
            "Women's 50m",
            "Women's 100m",
            "Women's 200m",
            "Women's 400m",
            "Women's 800m",
            "Men's 50m",
            "Men's 100m",
            "Men's 200m",
            "Men's 400m",
            "Men's 800m"
          ],
          "title": "Freestyle Event",
          "scale": {
            "paddingInner": 0.25,
            "paddingOuter": 0
          }
        },
        "x": {
          "aggregate": "min",
          "field": "top200_count",
          "type": "quantitative",
          "title": "Number of Top 200 Performances",
          "scale": {
            "domain": [0, 110],
            "nice": false
          }
        },
        "x2": {
          "aggregate": "max",
          "field": "top200_count"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 180,
        "stroke": "white",
        "strokeWidth": 1.5,
        "opacity": 0.95
      },
      "encoding": {
        "y": {
          "field": "event_label",
          "type": "nominal",
          "sort": [
            "Women's 50m",
            "Women's 100m",
            "Women's 200m",
            "Women's 400m",
            "Women's 800m",
            "Men's 50m",
            "Men's 100m",
            "Men's 200m",
            "Men's 400m",
            "Men's 800m"
          ]
        },
        "x": {
          "field": "top200_count",
          "type": "quantitative",
          "scale": {
            "domain": [0, 110],
            "nice": false
          }
        },
        "color": {
          "field": "country",
          "type": "nominal",
          "scale": {
            "domain": ["AUS", "USA"],
            "range": ["#1E88E5", "#A9B4BE"]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "event_label", "title": "Event" },
          { "field": "country", "title": "Country" },
          { "field": "top200_count", "title": "Top 200 Performances" },
          { "field": "best_rank", "title": "Best Rank" },
          { "field": "best_athlete", "title": "Best Athlete" }
        ]
      }
    },

    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "rect",
        "fill": "white",
        "fillOpacity": 0.95,
        "stroke": "#D6DEE3",
        "strokeWidth": 1.2,
        "cornerRadius": 6
      },
      "encoding": {
        "x": { "value": 443 },
        "x2": { "value": 525 },
        "y": { "value": 220 },
        "y2": { "value": 290 }
      }
    },

    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#102A3A"
      },
      "encoding": {
        "x": { "value": 460 },
        "y": { "value": 235 },
        "text": { "value": "Country" }
      }
    },

    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "circle",
        "size": 120,
        "fill": "#1E88E5",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": { "value": 465 },
        "y": { "value": 255 }
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#263238"
      },
      "encoding": {
        "x": { "value": 480 },
        "y": { "value": 255 },
        "text": { "value": "AUS" }
      }
    },

    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "circle",
        "size": 120,
        "fill": "#A9B4BE",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": { "value": 465 },
        "y": { "value": 275 }
      }
    },
    {
      "data": {
        "values": [{}]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#263238"
      },
      "encoding": {
        "x": { "value": 480 },
        "y": { "value": 275 },
        "text": { "value": "USA" }
      }
    }
  ],
  "title": "Australia vs USA: Freestyle Top 200 Depth by Event",
  "background": "transparent",
  "view": {
    "stroke": null
  },
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#D6DEE3",
      "gridOpacity": 0.8,
      "domainColor": "#8FA0AA",
      "tickColor": "#8FA0AA"
    },
    "title": {
      "fontSize": 17,
      "anchor": "middle",
      "fontWeight": "bold"
    }
  }
}