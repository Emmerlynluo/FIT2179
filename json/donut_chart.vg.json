{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 320,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/australia_summer_olympic_medals_by_sport_wide.csv"
  },
  "transform": [
    {
      "filter": "datum.total > 0"
    },
    {
      "calculate": "datum.sport == 'Swimming' ? 'Swimming' : 'Other sports'",
      "as": "sport_group"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "gold",
          "as": "gold"
        },
        {
          "op": "sum",
          "field": "silver",
          "as": "silver"
        },
        {
          "op": "sum",
          "field": "bronze",
          "as": "bronze"
        },
        {
          "op": "sum",
          "field": "total",
          "as": "total"
        }
      ],
      "groupby": ["sport_group"]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "total",
          "as": "overall_total"
        }
      ]
    },
    {
      "calculate": "datum.total / datum.overall_total",
      "as": "share"
    },
    {
      "calculate": "format(datum.share, '.1%')",
      "as": "share_label"
    },
    {
      "calculate": "datum.sport_group == 'Swimming' ? 1 : 2",
      "as": "group_order"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 78,
        "outerRadius": 140,
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "total",
          "type": "quantitative"
        },
        "color": {
          "field": "sport_group",
          "type": "nominal",
          "scale": {
            "domain": ["Swimming", "Other sports"],
            "range": ["#9AD4F5", "#d9d9d9"]
          },
          "legend": null
        },
        "order": {
          "field": "group_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "sport_group",
            "title": "Group"
          },
          {
            "field": "gold",
            "title": "Gold"
          },
          {
            "field": "silver",
            "title": "Silver"
          },
          {
            "field": "bronze",
            "title": "Bronze"
          },
          {
            "field": "total",
            "title": "Total medals"
          },
          {
            "field": "share_label",
            "title": "Share of total"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 40,
        "fontWeight": "bold",
        "color": "#003049"
      },
      "encoding": {
        "text": {
          "value": "38.3%"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 34,
        "fontSize": 15,
        "color": "#333333"
      },
      "encoding": {
        "text": {
          "value": "from Swimming"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 17,
      "anchor": "start"
    },
    "background": "transparent",
    "view": {
      "stroke": null
    }
  }
}