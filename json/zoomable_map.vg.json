{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australia Olympic Swimming Medals by Host City",
    "fontSize": 18,
    "anchor": "start",
    "offset": 10
  },

  "width": 760,
  "height": 350,

  "autosize": {
    "type": "fit"
  },

  "params": [
    {
      "name": "viewMode",
      "value": "All history",
      "bind": {
        "input": "select",
        "options": ["All history", "Selected Olympic year"],
        "name": "View mode: "
      }
    },
    {
      "name": "yearSelection",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 1896,
        "max": 2024,
        "step": 4,
        "name": "Year: "
      }
    },
    {
      "name": "medalSelection",
      "value": "Total",
      "bind": {
        "input": "select",
        "options": ["Total", "Gold", "Silver", "Bronze"],
        "name": "Medal type: "
      }
    },
    {
      "name": "zoomLevel",
      "value": 195,
      "bind": {
        "input": "range",
        "min": 90,
        "max": 650,
        "step": 5,
        "name": "Zoom: "
      }
    },
    {
      "name": "centerSelection",
      "value": "World",
      "bind": {
        "input": "select",
        "options": [
          "World",
          "Australia-Pacific",
          "Europe",
          "Americas",
          "Asia"
        ],
        "name": "Map centre: "
      }
    }
  ],

  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "centerSelection == 'Australia-Pacific' ? [145, -25] : centerSelection == 'Europe' ? [15, 50] : centerSelection == 'Americas' ? [-75, 25] : centerSelection == 'Asia' ? [115, 25] : [20, 15]"
    },
    "scale": {
      "expr": "zoomLevel"
    }
  },

  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6ECEF",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      }
    },

    {
      "data": {
        "values": [
          {"name": "North America", "lon": -105, "lat": 48},
          {"name": "South America", "lon": -60, "lat": -18},
          {"name": "Europe", "lon": 15, "lat": 53},
          {"name": "Africa", "lon": 20, "lat": 4},
          {"name": "Asia", "lon": 90, "lat": 45},
          {"name": "Australia", "lon": 135, "lat": -25},
          {"name": "Pacific Ocean", "lon": -150, "lat": 0},
          {"name": "Atlantic Ocean", "lon": -35, "lat": 3},
          {"name": "Indian Ocean", "lon": 80, "lat": -28}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "color": "#6F8C9A",
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_swimming_host_city_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "viewMode == 'All history'"
        },
        {
          "calculate": "medalSelection == 'Gold' ? datum.Gold : medalSelection == 'Silver' ? datum.Silver : medalSelection == 'Bronze' ? datum.Bronze : datum.Total",
          "as": "SelectedMedalCount"
        },
        {
          "filter": "datum.SelectedMedalCount > 0"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.58,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [1, 25],
            "range": [70, 1200]
          },
          "legend": null
        },
        "color": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [1, 25],
            "scheme": "blues"
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Edition",
            "type": "nominal",
            "title": "Olympic Games"
          },
          {
            "field": "HostCity",
            "type": "nominal",
            "title": "Host City"
          },
          {
            "field": "HostCountry",
            "type": "nominal",
            "title": "Host Country"
          },
          {
            "field": "Region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "Gold",
            "type": "quantitative",
            "title": "Gold"
          },
          {
            "field": "Silver",
            "type": "quantitative",
            "title": "Silver"
          },
          {
            "field": "Bronze",
            "type": "quantitative",
            "title": "Bronze"
          },
          {
            "field": "Total",
            "type": "quantitative",
            "title": "Total"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_swimming_host_city_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "viewMode == 'Selected Olympic year'"
        },
        {
          "filter": "toNumber(datum.Year) == yearSelection"
        },
        {
          "calculate": "medalSelection == 'Gold' ? datum.Gold : medalSelection == 'Silver' ? datum.Silver : medalSelection == 'Bronze' ? datum.Bronze : datum.Total",
          "as": "SelectedMedalCount"
        },
        {
          "filter": "datum.SelectedMedalCount > 0"
        },
        {
          "calculate": "datum.Year + ' ' + datum.HostCity",
          "as": "SelectedEdition"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.9,
        "stroke": "#1B1B1B",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [1, 25],
            "range": [70, 1200]
          },
          "legend": null
        },
        "color": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [1, 25],
            "scheme": "blues"
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "SelectedEdition",
            "type": "nominal",
            "title": "Olympic Games"
          },
          {
            "field": "HostCity",
            "type": "nominal",
            "title": "Host City"
          },
          {
            "field": "HostCountry",
            "type": "nominal",
            "title": "Host Country"
          },
          {
            "field": "Region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "Gold",
            "type": "quantitative",
            "title": "Gold"
          },
          {
            "field": "Silver",
            "type": "quantitative",
            "title": "Silver"
          },
          {
            "field": "Bronze",
            "type": "quantitative",
            "title": "Bronze"
          },
          {
            "field": "Total",
            "type": "quantitative",
            "title": "Total"
          },
          {
            "field": "SelectedMedalCount",
            "type": "quantitative",
            "title": "Selected Medal Count"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_swimming_host_city_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "viewMode == 'Selected Olympic year'"
        },
        {
          "filter": "toNumber(datum.Year) == yearSelection"
        },
        {
          "calculate": "medalSelection == 'Gold' ? datum.Gold : medalSelection == 'Silver' ? datum.Silver : medalSelection == 'Bronze' ? datum.Bronze : datum.Total",
          "as": "SelectedMedalCount"
        },
        {
          "filter": "datum.SelectedMedalCount > 0"
        },
        {
          "calculate": "datum.HostCity + ' ' + datum.Year + ': ' + datum.SelectedMedalCount",
          "as": "LabelText"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1F2A33",
        "dx": 10,
        "dy": -10,
        "align": "left",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "LabelText",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "values": [
          {"x": 5, "y": 190, "x2": 115, "y2": 330}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "white",
        "opacity": 0.86,
        "stroke": "#D0D0D0",
        "strokeWidth": 1,
        "cornerRadius": 4
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y2": {
          "field": "y2"
        }
      }
    },

    {
      "data": {
        "values": [
          {"label": "Medal Count", "x": 15, "y": 208}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "middle",
        "color": "#1F2A33"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },

    {
      "data": {
        "values": [
          {"LegendMedalCount": 5, "label": "5", "x": 30, "y": 227},
          {"LegendMedalCount": 10, "label": "10", "x": 30, "y": 247},
          {"LegendMedalCount": 15, "label": "15", "x": 30, "y": 273},
          {"LegendMedalCount": 25, "label": "25", "x": 30, "y": 305}
        ]
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "fill": "#4C8DCA",
        "stroke": "#FFFFFF",
        "strokeWidth": 1,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "size": {
          "field": "LegendMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [1, 25],
            "range": [70, 1200]
          },
          "legend": null
        }
      }
    },

    {
      "data": {
        "values": [
          {"label": "5 medals", "x": 55, "y": 227},
          {"label": "10 medals", "x": 55, "y": 247},
          {"label": "15 medals", "x": 55, "y": 273},
          {"label": "25 medals", "x": 55, "y": 305}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "align": "left",
        "baseline": "middle",
        "color": "#1F2A33"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false
    },
    "legend": {
      "disable": true
    }
  }
}