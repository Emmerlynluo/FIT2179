{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Australia Olympic Swimming Medals by Host City",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start"
  },

  "width": 760,
  "height": 350,
    "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "params": [
    {
      "name": "viewMode",
      "value": "All history",
      "bind": {
        "input": "select",
        "options": ["All history", "Selected Olympic year"],
        "name": "View mode: "
      }
    },
    {
      "name": "yearSelection",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 1896,
        "max": 2024,
        "step": 4,
        "name": "Year: "
      }
    },
    {
      "name": "medalSelection",
      "value": "Total",
      "bind": {
        "input": "select",
        "options": ["Total", "Gold", "Silver", "Bronze"],
        "name": "Medal type: "
      }
    },
    {
      "name": "zoomLevel",
      "value": 145,
      "bind": {
        "input": "range",
        "min": 90,
        "max": 650,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "centerSelection",
      "value": "World",
      "bind": {
        "input": "select",
        "options": [
          "World",
          "Australia-Pacific",
          "Europe",
          "Americas",
          "Asia"
        ],
        "name": "Map centre: "
      }
    }
  ],

  "projection": {
    "type": "equalEarth",
    "center": {
      "expr": "centerSelection == 'Australia-Pacific' ? [145, -25] : centerSelection == 'Europe' ? [15, 50] : centerSelection == 'Americas' ? [-75, 25] : centerSelection == 'Asia' ? [115, 25] : [20, 15]"
    },
    "scale": {
      "expr": "zoomLevel"
    }
  },

  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8E8E8",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_swimming_host_city_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "viewMode == 'All history'"
        },
        {
          "calculate": "medalSelection == 'Gold' ? datum.Gold : medalSelection == 'Silver' ? datum.Silver : medalSelection == 'Bronze' ? datum.Bronze : datum.Total",
          "as": "SelectedMedalCount"
        },
        {
          "calculate": "datum.HostCity + ' ' + datum.Year + ': ' + datum.SelectedMedalCount",
          "as": "BubbleLabel"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.55,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "title": "Medal Count",
          "scale": {
            "domain": [0, 25],
            "range": [40, 1100]
          },
          "legend": {
            "orient": "right"
          }
        },
        "color": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "title": "Medal Count",
          "scale": {
            "domain": [0, 25],
            "scheme": "blues"
          },
          "legend": {
            "orient": "right"
          }
        },
        "tooltip": [
          {
            "field": "Edition",
            "type": "nominal",
            "title": "Olympic Games"
          },
          {
            "field": "HostCountry",
            "type": "nominal",
            "title": "Host Country"
          },
          {
            "field": "Region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "Gold",
            "type": "quantitative",
            "title": "Gold"
          },
          {
            "field": "Silver",
            "type": "quantitative",
            "title": "Silver"
          },
          {
            "field": "Bronze",
            "type": "quantitative",
            "title": "Bronze"
          },
          {
            "field": "Total",
            "type": "quantitative",
            "title": "Total"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_swimming_host_city_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "viewMode == 'Selected Olympic year'"
        },
        {
          "filter": "toNumber(datum.Year) == yearSelection"
        },
        {
          "calculate": "medalSelection == 'Gold' ? datum.Gold : medalSelection == 'Silver' ? datum.Silver : medalSelection == 'Bronze' ? datum.Bronze : datum.Total",
          "as": "SelectedMedalCount"
        },
        {
          "calculate": "datum.Year + ' ' + datum.HostCity",
          "as": "SelectedEdition"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.9,
        "stroke": "black",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [0, 25],
            "range": [100, 1800]
          },
          "legend": {
            "orient": "right"
          }
        },
        "color": {
          "field": "SelectedMedalCount",
          "type": "quantitative",
          "scale": {
            "domain": [0, 25],
            "scheme": "blues"
          },
          "legend": {
            "orient": "right"
          }
        },
        "tooltip": [
          {
            "field": "SelectedEdition",
            "type": "nominal",
            "title": "Olympic Games"
          },
          {
            "field": "HostCountry",
            "type": "nominal",
            "title": "Host Country"
          },
          {
            "field": "Region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "Gold",
            "type": "quantitative",
            "title": "Gold"
          },
          {
            "field": "Silver",
            "type": "quantitative",
            "title": "Silver"
          },
          {
            "field": "Bronze",
            "type": "quantitative",
            "title": "Bronze"
          },
          {
            "field": "Total",
            "type": "quantitative",
            "title": "Total"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/Emmerlynluo/FIT2179/refs/heads/main/data/aus_swimming_host_city_symbol_map.csv"
      },
      "transform": [
        {
          "filter": "viewMode == 'Selected Olympic year'"
        },
        {
          "filter": "toNumber(datum.Year) == yearSelection"
        },
        {
          "calculate": "medalSelection == 'Gold' ? datum.Gold : medalSelection == 'Silver' ? datum.Silver : medalSelection == 'Bronze' ? datum.Bronze : datum.Total",
          "as": "SelectedMedalCount"
        },
        {
          "filter": "datum.SelectedMedalCount > 0"
        },
        {
          "calculate": "datum.HostCity + ' ' + datum.Year + ': ' + datum.SelectedMedalCount",
          "as": "LabelText"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "dx": 10,
        "dy": -10,
        "align": "left",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "LabelText",
          "type": "nominal"
        }
      }
    }
  ],

  "config": {
    "background": "white",
    "title": {
      "font": "sans-serif"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  }
}